---
// Participants' portal for The 8-Day Purposeful Content Shift™.
// Private: not linked anywhere on the website, hidden from search. Send the link in the Flodesk welcome email.
// Each day unlocks after she turns in the day before. Progress is saved on her own phone or computer.
import Base from '../layouts/Base.astro';
import { CHALLENGE, QUIZ_UNLOCKED_URL, APPLY_URL } from '../site';

const niche = `You are a Christian business coach who helps women of faith turn their gifts, expertise and life experience into a clear coaching niche.

Here is my information:
- What people already come to me for: [ANSWER]
- My experience, career or ministry background: [ANSWER]
- A pain or struggle I have personally overcome: [ANSWER]
- The kind of person I love serving most: [ANSWER]
- My Spiritual Daughter Archetype from the Which Daughter Are You? quiz: [Church Girl / Mystic Daughter / Called Daughter]

Step 1: Based on my answers, give me 3 possible niches. For each one, name the exact person I would serve (her age range, season of life and what she is struggling with).

Step 2: For each niche, write 2 purpose statements:
A) Desire version: "I help [who] achieve [desire] by [how I help them / what I give them]."
B) Pain point version: "I help [who] come out of [pain point] and step into [desire] by [how I help them / what I give them]."

Step 3: Tell me which niche fits my story and gifts best, and why.

Keep the language simple, warm and clear, the way I would say it out loud. Do not use the word "empower."`;

const post = `You are a content writer for faith-based coaches. Use my Amen to Opt-In™ content formula to turn one question my ideal client is asking into ready-to-post content.

My details:
- My ideal client: [WHO SHE IS]
- What she wants: [HER DESIRED OUTCOME]
- What's in her way: [HER PROBLEM]
- My name and credential: [YOUR NAME, PLUS YEARS, ROLE OR A RESULT]
- My purpose statement: [PASTE YOUR PURPOSE STATEMENT]
- The question: [PASTE ONE QUESTION FROM YOUR LIST]

The rules:
- The hook is the first 3 to 5 seconds, and it calls out her or her problem, in her words.
- Each video runs 7 to 60 seconds.
- Each video has one call to action: follow me, or meet me live.

Write 3 videos for this question:

1. Problem video
- Hook: call out one core problem in her words.
- Body: name what it costs her, then give one reframe: the lie she believes, then my truth.
- Call to action: follow me, or meet me live.

2. Desire video
- Hook: say what she secretly wants (for example, "You want to show up online without feeling like a fraud").
- Body: paint the picture of that outcome, then show her it's possible.
- Call to action: follow me, or meet me live.

3. Tip video
- Hook: promise one quick win (for example, "One thing to change in your bio today").
- Body: give the tip in 2 to 3 steps.
- Call to action: follow me, or meet me live.

For each video, give me:
- The spoken script for a talking head video, labeled Hook, Body and Call to Action
- Short on-screen text lines I can put over B-roll clips of my everyday life
- A caption under 100 words

Then turn the Tip video into a carousel of 5 to 7 slides: slide 1 is the hook, the middle slides are the steps, and the last slide is the call to action.

Make my on-screen hook text match my spoken hook. Write the way I would talk to a friend: simple, warm and clear.`;

const questions = `You are a content strategist for faith-based coaches.

My purpose statement: [PASTE YOUR PURPOSE STATEMENT]
My ideal client: [DESCRIBE HER IN 2 OR 3 SENTENCES]

Give me 25 real questions my ideal client is typing into Google, TikTok search and YouTube about her struggle. Write each question the way she would actually type it, in her own words.

For each question:
1. Write one hook (3 to 5 seconds when spoken) that calls out her or her problem, in her words.
2. Tell me which video type fits it best: Problem video, Desire video or Tip video.

Number the questions 1 to 25 so I can save them in my notes app.`;

type Day = { title: string; why: string; formula?: boolean; steps: string[]; prompt?: { name: string; text: string }; link?: { label: string; href: string }; homework: string[] };

const days: Day[] = [
  {
    title: 'Who You Are',
    why: 'Before you create one piece of content, you need to know who you are. Your identity shapes how you speak, who you are called to, and what you have to offer.',
    steps: [
      'Take the Which Daughter Are You? mini quiz. It is your free bonus.',
      'Read your results slowly. Write down your Daughter, who you are called to serve, and the offer ideas that stood out to you.',
      'Pray over your results. Ask the Lord what He wants you to see.',
    ],
    link: { label: 'Take My Mini Quiz', href: QUIZ_UNLOCKED_URL },
    homework: ['A screenshot of your quiz results', 'In one or two sentences: what surprised you about your results?'],
  },
  {
    title: 'Find Your Niche',
    why: 'You are not called to everybody. When you know exactly who you are speaking to, the right woman recognizes herself in your content.',
    steps: [
      'Copy the prompt below into ChatGPT.',
      'Replace every [ANSWER] with your own words. Use your Daughter from Day 1.',
      'Read the 3 niches it gives you, and choose the one that fits your story and your gifts.',
    ],
    prompt: { name: 'Prompt 1: Find Your Niche and Write Your Purpose Statement', text: niche },
    homework: ['The niche you chose', 'A short description of the woman you are called to serve'],
  },
  {
    title: 'Write Your Purpose Statement',
    why: 'Your purpose statement is the foundation for everything you post. It tells people who you help, what you help them do, and how.',
    steps: [
      'Look at the purpose statements from your Prompt 1 results.',
      'Choose one way to say it. Desire way: “I help [who] achieve [desire] by [how].” Pain point way: “I help [who] come out of [pain point] and step into [desire] by [how].”',
      'Make it sound like you. Say it out loud three times until it feels natural.',
    ],
    homework: ['Your final purpose statement: “I help…”'],
  },
  {
    title: 'The 25 Questions She Is Asking',
    why: 'Your ideal client is already asking questions. When your content answers them, she finds you, and she trusts you.',
    steps: [
      'Copy the prompt below into ChatGPT.',
      'Paste in your purpose statement and a description of your ideal client.',
      'Save your 25 questions and hooks in your phone’s notes app. These are your content ideas for the rest of the challenge.',
      'Star the 10 questions that excite you most.',
    ],
    prompt: { name: 'Prompt 2: The 25 Questions Your Ideal Client Is Asking', text: questions },
    homework: ['A screenshot of your 25 questions', 'Your 10 starred questions'],
  },
  {
    title: 'Turn Your Questions Into Posts',
    why: 'Every question she is asking is a post waiting to be made. Today you learn my Amen to Opt-In™ formula, the formula that turns an audience that says “amen” into women who ask, “How do I join?”',
    formula: true,
    steps: [
      'Read the Amen to Opt-In™ formula above. Every video and carousel you make follows it, and each one is a Problem, Desire or Tip video.',
      'Choose one of your 10 starred questions.',
      'Copy the prompt below into ChatGPT. Fill in your details and paste in that question.',
      'ChatGPT will write a Problem video, a Desire video and a Tip video for that question, each with a talking head script, B-roll text and a caption, plus a carousel.',
      'Repeat with more of your starred questions. Save everything in your notes app. These are the posts you will create on Days 6, 7 and 8.',
    ],
    prompt: { name: 'Prompt 3: Turn a Question Into a Post', text: post },
    homework: ['A screenshot of your post ideas for at least 5 questions'],
  },
  {
    title: 'Set Up Your Phone and Make Talking Head Videos',
    why: 'All you need is your phone. Today you set up your account and start speaking to the woman God sent you to.',
    steps: [
      'Download two apps: TikTok and TikTok Studio.',
      'Set up your profile: a clear photo of you, your name, and a bio built from your purpose statement.',
      'Talking head video: you speaking to the camera. Your hook calls out her or her problem in the first 3 to 5 seconds, then your body, then one call to action: follow me, or meet me live. Keep it between 7 and 60 seconds.',
      'Use the scripts you wrote with Prompt 3 on Day 5. Put your hook on the screen as text too, matching what you say.',
      'Check your on-screen text for typos before you save.',
      'Save your videos as drafts so you can schedule them in TikTok Studio.',
    ],
    homework: ['A screenshot of your TikTok profile', 'Record 3 talking head videos and screenshot your drafts'],
  },
  {
    title: 'B-Roll Videos and Carousels',
    why: 'Not every post needs you talking. B-roll and carousels let you show up with purpose, even on the days you don’t feel camera ready.',
    steps: [
      'B-roll video: short clips of your everyday life (your coffee, your Bible, your desk, a walk) with your hook, body and call to action written on the screen. Use the B-roll text ChatGPT wrote for you on Day 5.',
      'Carousel: 5 to 7 photo slides. Slide 1 is your hook, the middle slides give the steps, and the last slide is your one call to action. Use the carousel ChatGPT wrote for you on Day 5.',
      'Batch day: make 10 pieces of content today, mixing all three styles.',
    ],
    homework: ['A screenshot of your 10 pieces of content'],
  },
  {
    title: 'Schedule It and Show Up',
    why: 'Consistency builds trust. Today you schedule your content so you show up three times a day, with purpose and with confidence.',
    steps: [
      'Open TikTok Studio and schedule your saved content: morning, midday and evening.',
      'Count your content. You should have 20 or more pieces posted or scheduled.',
      'Go live or post one video introducing yourself with your purpose statement.',
      'Celebrate what God did in eight days. You are not just posting. You are inviting.',
    ],
    homework: ['A screenshot of your scheduled posts', 'Your biggest breakthrough from these eight days'],
  },
];
---
<Base
  title="Your 8-Day Purposeful Content Shift™ | Kingdom Roe"
  description="Participant portal for The 8-Day Purposeful Content Shift™."
  noindex
>
  <section class="band portal-head">
    <div class="wrap narrow">
      <p class="eyebrow">Participant portal</p>
      <h1>Welcome to The 8-Day Purposeful Content Shift™</h1>
      <hr class="rule" />
      <p class="lede">Blessings, woman of God. Each day unlocks after you finish the day before. Do the steps, turn in your homework with your screenshots, and then mark the day complete.</p>
      <p class="tip">Use the same phone or computer each day. Your progress is saved on this device.</p>
      <div class="progress" aria-live="polite"><div class="bar"><i id="bar"></i></div><p id="progress-text">Day 1 of 8</p></div>
    </div>
  </section>

  <section class="band white">
    <div class="wrap narrow days">
      {days.map((d, i) => (
        <article class="day locked" data-day={i + 1} id={`day-${i + 1}`}>
          <header class="day-head">
            <span class="num">{i + 1}</span>
            <div>
              <p class="eyebrow">Day {i + 1}</p>
              <h2>{d.title}</h2>
            </div>
            <span class="status" aria-hidden="true"></span>
          </header>
          <p class="locked-note">Finish Day {i} to unlock this day.</p>
          <div class="day-body">
            <p class="why">{d.why}</p>
            {d.formula && (
              <div class="formula">
                <h3>The Amen to <span class="nw">Opt-In™</span> Formula</h3>
                <p class="flow">Hook · Problem · Solution · Authority · Call to Action</p>
                <ul>
                  <li>The <b>hook</b> is the first 3 to 5 seconds. It calls out her or her problem.</li>
                  <li>Videos run <b>7 to 60 seconds</b>, with <b>one call to action</b>: follow me, or meet me live.</li>
                </ul>
                <div class="types">
                  <div class="type">
                    <h4>Problem video</h4>
                    <p><b>Hook:</b> call out one core problem in her words.</p>
                    <p><b>Body:</b> name what it costs her, then give one reframe: the lie she believes, then your truth.</p>
                    <p><b>Call to action:</b> follow me, or meet me live.</p>
                  </div>
                  <div class="type">
                    <h4>Desire video</h4>
                    <p><b>Hook:</b> say what she secretly wants. “You want to show up online without feeling like a fraud.”</p>
                    <p><b>Body:</b> paint the picture of that outcome, then show her it’s possible.</p>
                    <p><b>Call to action:</b> follow me, or meet me live.</p>
                  </div>
                  <div class="type">
                    <h4>Tip video</h4>
                    <p><b>Hook:</b> promise one quick win. “One thing to change in your bio today.”</p>
                    <p><b>Body:</b> give the tip in 2 to 3 steps.</p>
                    <p><b>Call to action:</b> follow me, or meet me live.</p>
                  </div>
                </div>
              </div>
            )}
            <h3>Today’s steps</h3>
            <ol class="steps">{d.steps.map((s) => <li>{s}</li>)}</ol>
            {d.link && <p><a class="btn" href={d.link.href} target="_blank" rel="noopener">{d.link.label}</a></p>}
            {d.prompt && (
              <div class="prompt">
                <div class="prompt-head"><h3>{d.prompt.name}</h3><button class="copy" type="button">Copy prompt</button></div>
                <pre>{d.prompt.text}</pre>
              </div>
            )}
            <div class="homework">
              <h3>Your homework</h3>
              <ul>{d.homework.map((h) => <li>{h}</li>)}</ul>
              {CHALLENGE.homeworkForm
                ? <a class="btn brown" href={CHALLENGE.homeworkForm} target="_blank" rel="noopener">Turn In Day {i + 1} Homework</a>
                : <span class="btn brown off" aria-disabled="true">Homework form coming soon</span>}
              <label class="confirm"><input type="checkbox" class="done-check" /> I turned in my Day {i + 1} homework and screenshots.</label>
              <button class="btn complete" type="button" disabled>{i === 7 ? 'Complete the Challenge' : `Complete Day ${i + 1} and Unlock Day ${i + 2}`}</button>
            </div>
          </div>
        </article>
      ))}

      <div class="finish" id="finish" hidden>
        <p class="eyebrow">You did it</p>
        <h2>You’ve Shifted From Encouragement to Attraction</h2>
        <p>You know who you are, who you are called to serve, and how to show up for her. If you’re ready to turn your content into a flagship offer that attracts clients and creates income, I’d love to walk with you.</p>
        <div><a class="btn" href={APPLY_URL} target="_blank" rel="noopener">Apply to Work With Me</a></div>
      </div>
    </div>
  </section>
</Base>

<script is:inline>
  (function () {
    var KEY = 'kr-8day-done';
    var done = [];
    try { done = JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (e) { done = []; }
    if (!Array.isArray(done)) done = [];
    function save() { try { localStorage.setItem(KEY, JSON.stringify(done)); } catch (e) {} }
    var days = Array.prototype.slice.call(document.querySelectorAll('.day'));
    function render() {
      var unlocked = 1;
      while (done.indexOf(unlocked) !== -1 && unlocked < 9) unlocked++;
      days.forEach(function (el) {
        var n = +el.dataset.day;
        var isDone = done.indexOf(n) !== -1;
        el.classList.toggle('locked', n > unlocked);
        el.classList.toggle('done', isDone);
        el.querySelector('.status').textContent = isDone ? 'Complete' : (n > unlocked ? 'Locked' : 'Open');
        var btn = el.querySelector('.complete');
        var chk = el.querySelector('.done-check');
        if (isDone) { chk.checked = true; chk.disabled = true; btn.disabled = true; }
      });
      var count = Math.min(done.length, 8);
      document.getElementById('bar').style.width = (count / 8 * 100) + '%';
      document.getElementById('progress-text').textContent = count >= 8 ? 'All 8 days complete' : 'Day ' + Math.min(unlocked, 8) + ' of 8 · ' + count + ' complete';
      document.getElementById('finish').hidden = count < 8;
    }
    days.forEach(function (el) {
      var n = +el.dataset.day;
      var chk = el.querySelector('.done-check');
      var btn = el.querySelector('.complete');
      chk.addEventListener('change', function () { btn.disabled = !chk.checked; });
      btn.addEventListener('click', function () {
        if (!chk.checked || done.indexOf(n) !== -1) return;
        done.push(n); save(); render();
        var next = document.getElementById(n < 8 ? 'day-' + (n + 1) : 'finish');
        if (next) next.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
      var copy = el.querySelector('.copy');
      if (copy) copy.addEventListener('click', function () {
        var text = el.querySelector('pre').textContent;
        var ok = function () { copy.textContent = 'Copied'; setTimeout(function () { copy.textContent = 'Copy prompt'; }, 1800); };
        if (navigator.clipboard) navigator.clipboard.writeText(text).then(ok, function () {});
      });
    });
    render();
  })();
</script>

<style>
  .narrow { max-width: 780px; }
  .portal-head .narrow { display: grid; gap: 16px; }
  h1 { font-size: clamp(34px, 4.6vw, 50px); }
  .tip { font-size: 14px; color: var(--muted); }
  .progress { display: grid; gap: 8px; margin-top: 8px; }
  .bar { height: 8px; background: var(--pink-soft); border-radius: 999px; overflow: hidden; }
  .bar i { display: block; height: 100%; width: 0; background: var(--pink); transition: width .4s ease; }
  #progress-text { font-size: 14px; font-weight: 600; color: var(--pink-deep); }

  .days { display: grid; gap: 24px; }
  .day { border: 1px solid var(--line); border-radius: var(--radius); background: var(--canvas); padding: 28px; display: grid; gap: 18px; }
  .day.done { border-color: var(--pink-line); }
  .day-head { display: grid; grid-template-columns: auto 1fr auto; gap: 16px; align-items: center; }
  .day-head h2 { font-size: clamp(24px, 3vw, 30px); }
  .num { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; background: var(--pink); color: #fff; font-family: var(--display); font-size: 24px; font-weight: 700; }
  .status { font-size: 12px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--pink-deep); }
  .locked-note { display: none; color: var(--muted); font-size: 15px; }
  .day.locked { opacity: .6; }
  .day.locked .num { background: var(--muted); }
  .day.locked .day-body { display: none; }
  .day.locked .locked-note { display: block; }
  .day-body { display: grid; gap: 16px; }
  .why { font-family: var(--display); font-style: italic; font-size: 21px; line-height: 1.45; color: var(--pink-deep); }
  .day-body h3 { font-family: var(--sans); font-size: 15px; font-weight: 700; letter-spacing: .04em; color: var(--ink); }
  .steps, .homework ul { margin: 0; padding-left: 22px; display: grid; gap: 8px; }
  .formula { background: var(--pink-faint); border: 1px solid var(--pink-line); border-radius: 12px; padding: 20px; display: grid; gap: 10px; }
  .formula h3 { font-family: var(--display); font-size: 24px; letter-spacing: 0; }
  .formula ol { margin: 0; padding-left: 22px; display: grid; gap: 8px; }
  .nw { white-space: nowrap; }
  .flow { font-size: 13px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--pink-deep); }
  .formula ul { margin: 0; padding-left: 22px; display: grid; gap: 6px; }
  .types { display: grid; gap: 12px; margin-top: 6px; }
  .type { background: var(--white); border-radius: 10px; padding: 14px 16px; display: grid; gap: 6px; }
  .type h4 { font-family: var(--display); font-size: 21px; color: var(--ink); margin: 0; }
  .type p { font-size: 15px; }
  .prompt { background: var(--white); border: 1px solid var(--line); border-radius: 12px; padding: 18px; display: grid; gap: 12px; }
  .prompt-head { display: flex; flex-wrap: wrap; gap: 10px; justify-content: space-between; align-items: center; }
  .copy { appearance: none; border: 1px solid var(--pink); background: var(--pink-faint); color: var(--pink-deep); border-radius: 999px; padding: 10px 18px; min-height: 44px; font: 600 14px var(--sans); cursor: pointer; }
  pre { margin: 0; white-space: pre-wrap; word-break: break-word; font: 14px/1.6 var(--sans); color: var(--body); max-height: 320px; overflow: auto; }
  .homework { background: var(--white); border-top: 4px solid var(--pink); border-radius: 12px; padding: 20px; display: grid; gap: 14px; justify-items: start; }
  .confirm { display: flex; gap: 10px; align-items: flex-start; font-size: 15px; cursor: pointer; }
  .confirm input { width: 20px; height: 20px; margin-top: 3px; accent-color: var(--pink); flex: none; }
  .complete[disabled] { opacity: .4; cursor: not-allowed; }
  .finish { text-align: center; display: grid; gap: 16px; justify-items: center; padding: 48px 24px; border-top: 6px solid var(--pink); border-radius: var(--radius); background: var(--pink-faint); }
  .finish h2 { font-size: clamp(28px, 4vw, 40px); }
  @media (max-width: 600px) {
    .day { padding: 22px 18px; }
    .day-head { grid-template-columns: auto 1fr; }
    .status { grid-column: 2; }
    .homework .btn { white-space: normal; text-align: center; }
  }
</style>
