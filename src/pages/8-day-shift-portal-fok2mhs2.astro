---
// Participants' portal for The 8-Day Purposeful Content Shift™.
// Private: not linked anywhere on the website, hidden from search. Send the link in the Flodesk welcome email.
// Each day unlocks after she turns in the day before. Progress is saved on her own phone or computer.
// Written for participants: warm steps only. Naomi's behind-the-scenes framework stays inside the prompts.
import Base from '../layouts/Base.astro';
import Mockup from '../components/Mockup.astro';
import { CHALLENGE, QUIZ_UNLOCKED_URL, APPLY_URL } from '../site';

const nichePrompt = `You are a Christian business coach who helps women of faith turn their gifts, expertise and life experience into a clear coaching niche.

Here is my information:
- What people already come to me for: [ANSWER]
- My experience, career or ministry background: [ANSWER]
- A pain or struggle I have personally overcome: [ANSWER]
- The kind of person I love serving most: [ANSWER]
- My Spiritual Daughter Archetype from the Which Daughter Are You? quiz: [Church Girl / Mystic Daughter / Called Daughter]

Step 1: Based on my answers, give me 3 possible niches. For each one, name the exact person I would serve (her age range, season of life and what she is struggling with).

Step 2: For each niche, write 2 purpose statements:
A) Desire version: "I help [who] achieve [desire] by [how I help them / what I give them]."
B) Pain point version: "I help [who] come out of [pain point] and step into [desire] by [how I help them / what I give them]."

Step 3: Tell me which niche fits my story and gifts best, and why.

Keep the language simple, warm and clear, the way I would say it out loud.`;

const questionsPrompt = `You are a content strategist for faith-based coaches.

My purpose statement: [PASTE YOUR PURPOSE STATEMENT]
The woman I serve: [DESCRIBE HER IN 2 OR 3 SENTENCES]

Give me 25 real questions the woman I serve is typing into Google, TikTok search and YouTube about her struggle. Write each question the way she would actually type it, in her own words.

Number them 1 to 25 so I can save them in my notes app.`;

const contentPrompt = `You are a content writer for faith-based coaches. Turn my questions into 20 pieces of ready-to-post content that solve real problems for the woman I serve and draw her to me.

My name and why she can trust me: [YOUR NAME, PLUS YEARS, ROLE OR A RESULT]
My purpose statement: [PASTE YOUR PURPOSE STATEMENT]
The woman I serve: [DESCRIBE HER IN 2 OR 3 SENTENCES]
My 25 questions: [PASTE YOUR 25 QUESTIONS]

Write every piece in this order:
1. Hook: one sentence for the first 3 seconds that calls out her or her problem.
2. Authority: one sentence with my name and why she can trust me.
3. Body: help her. Mix three kinds across the 20 pieces: solve her problem, give her one tip in 2 or 3 simple steps, or share one surprising fact and what it means for her.
4. Call to action: one step only, like "Follow me for more."

Create these 20 pieces, each from a different question:
- 8 talking head video scripts, 30 to 60 seconds each, that I can say to the camera.
- 6 B-roll videos: short lines of text to put on the screen over clips of my everyday life, plus a caption.
- 6 carousel posts: 5 to 7 slides each (slide 1 grabs her attention, the last slide invites her to follow me), plus a caption.

Number them 1 to 20. Write the way I would talk to a friend: simple, warm and clear. Keep every caption under 100 words.`;

type HowTo = { title: string; kind: 'talking' | 'broll' | 'carousel'; steps: string[] };
type Day = { title: string; why: string; steps: string[]; prompt?: { name: string; text: string; note?: string }; link?: { label: string; href: string }; howto?: HowTo[]; homework: string[] };

const talking: HowTo = {
  title: 'How to make a talking head video', kind: 'talking',
  steps: [
    'Choose one of your talking head scripts and read it out loud two or three times.',
    'Stand or sit facing a window so the light is on your face. Hold your phone at eye level, or lean it against something steady.',
    'Open TikTok, tap the plus sign, and record yourself saying your script. Look at the camera like you are talking to one friend.',
    'Tap Text and type your first line across the top of the screen, so she sees it even with the sound off.',
    'Check your text for typos. Then tap Next, write your caption, and post it or save it to schedule.',
  ],
};
const broll: HowTo = {
  title: 'How to make a B-roll video', kind: 'broll',
  steps: [
    'Record 3 to 5 short clips of your everyday life, 3 to 5 seconds each: your coffee, your Bible, your desk, your hands writing, a walk outside.',
    'Open TikTok, tap the plus sign, then tap Upload and choose your clips.',
    'Tap Text and add the lines from your B-roll script, one at a time, so each line shows for a few seconds.',
    'Add soft music from TikTok’s sounds. Check your text for typos.',
    'Write your caption, and post it or save it to schedule.',
  ],
};
const carousel: HowTo = {
  title: 'How to make a carousel post', kind: 'carousel',
  steps: [
    'Choose one of your carousel scripts.',
    'Make one simple slide for each line, using the free Canva app or the photos and text tools in TikTok. Use the same colors and font on every slide.',
    'Make slide 1 bold and easy to read. That is the slide that stops her scroll.',
    'Open TikTok, tap the plus sign, tap Upload, choose Photos, and select your slides in order.',
    'Write your caption, and post it or save it to schedule.',
  ],
};

const schedule = [
  ['Wed, Dec 2', 'Class: Day 1'],
  ['Thu, Dec 3', 'Class: Day 2'],
  ['Fri, Dec 4', 'Homework day'],
  ['Sat, Dec 5', 'Class: Day 4'],
  ['Sun, Dec 6', 'Homework day'],
  ['Mon, Dec 7', 'Class: Day 6'],
  ['Tue, Dec 8', 'Homework day'],
  ['Wed, Dec 9', 'Final class'],
];

const days: Day[] = [
  {
    title: 'Discover Who You Are',
    why: 'Before you create one piece of content, you need to know who you are. Your identity shapes how you speak, who you are called to, and what you have to offer.',
    steps: [
      'Take the Which Daughter Are You? mini quiz. It is your free bonus.',
      'Read your results slowly. Write down your Daughter, who you are called to serve, and the offer ideas that stood out to you.',
      'Pray over your results. Ask the Lord what He wants you to see.',
      'Download two apps on your phone: TikTok and TikTok Studio. Add a clear photo of you to your TikTok profile.',
    ],
    link: { label: 'Take My Mini Quiz', href: QUIZ_UNLOCKED_URL },
    homework: ['A screenshot of your quiz results'],
  },
  {
    title: 'Discover Who You’re Called to Serve',
    why: 'You are not called to everybody. When you know exactly who you are speaking to, the right woman recognizes herself in your content.',
    steps: [
      'Copy the prompt below into ChatGPT. Replace every [ANSWER] with your own words, and use your Daughter from Day 1.',
      'Read the 3 niches it gives you, and choose the one that fits your story and your gifts.',
      'Write a short description of the woman you serve. You will use it again on Days 4 and 5.',
    ],
    prompt: { name: 'Prompt 1: Find Your Niche and Your Purpose Statement', text: nichePrompt },
    homework: ['Your niche and a short description of the woman you serve'],
  },
  {
    title: 'Write Your Purpose Statement and Share Your Story',
    why: 'Your purpose statement tells people who you help, what you help them do, and how. Today you say it, and you introduce yourself to the women God is sending you.',
    steps: [
      'Look at the purpose statements from your Prompt 1 results, and choose the one that sounds most like you.',
      'Say it out loud until it feels natural. Then put it in your TikTok bio.',
      'Make your first piece of content: a short video telling your story. Share who you are, a little of your journey, and who you help. Keep it under 60 seconds, and end by inviting her to follow you.',
    ],
    howto: [talking],
    homework: ['Your purpose statement: “I help…”', 'A screenshot of your story video'],
  },
  {
    title: 'Discover What She’s Asking',
    why: 'The woman you serve is already asking questions. When your content answers them, she finds you, and she trusts you.',
    steps: [
      'Copy the prompt below into ChatGPT, with your purpose statement and your description of the woman you serve.',
      'Save your 25 questions in your phone’s notes app. These questions become your content tomorrow.',
      'Star the questions you feel most passionate about answering.',
    ],
    prompt: { name: 'Prompt 2: The 25 Questions She Is Asking', text: questionsPrompt },
    homework: ['A screenshot of your 25 questions'],
  },
  {
    title: 'Create Your 20 Pieces of Content',
    why: 'Today is the big one. You turn her questions into 20 pieces of content that solve her problems and draw her to you. You don’t have to film them all today. You will have them ready.',
    steps: [
      'Copy the prompt below into ChatGPT. Fill in your name, your purpose statement, the woman you serve, and paste in your 25 questions.',
      'ChatGPT will write 20 pieces for you: talking head video scripts, B-roll videos and carousel posts.',
      'Copy all 20 into your notes app, or into one document you can open on your phone.',
      'Read through them and change any words so they sound like you.',
    ],
    prompt: { name: 'Prompt 3: Create My 20 Pieces of Content', text: contentPrompt, note: 'If ChatGPT stops before it reaches number 20, type “continue” and it will finish.' },
    homework: ['A screenshot of your 20 pieces of content'],
  },
  {
    title: 'Make Your Talking Head Videos',
    why: 'A talking head video is you speaking to the camera. It is the fastest way for her to see you, hear you, and trust you.',
    steps: [
      'Use the talking head scripts from Day 5.',
      'Follow the steps below and make as many as you can today. Three is a wonderful start.',
      'Post them, or save them and schedule them in TikTok Studio.',
    ],
    howto: [talking],
    homework: ['Screenshots of the talking head videos you made'],
  },
  {
    title: 'Make Your B-Roll Videos and Carousels',
    why: 'Not every post needs you talking. B-roll videos and carousels let you show up with purpose, even on the days you don’t feel camera ready.',
    steps: [
      'Use the B-roll and carousel scripts from Day 5.',
      'Follow the steps below and make as many as you can today.',
      'Post them, or schedule them in TikTok Studio.',
    ],
    howto: [broll, carousel],
    homework: ['Screenshots of the B-roll videos and carousels you made'],
  },
  {
    title: 'Post With Confidence',
    why: 'You have your identity, your purpose, and 20 pieces of content ready. Today you show up, and you keep showing up after these eight days.',
    steps: [
      'Open TikTok Studio. Find the videos and posts you saved, and choose a day and time for each one to post. Spread them out so you show up every day.',
      'Keep your 20 pieces of content close. Whatever you have not filmed yet is ready for next week.',
      'Make one last video tonight sharing what God did for you in these eight days.',
      'Celebrate. You are not just posting. You are attracting the women God sent you to.',
    ],
    homework: ['A screenshot of your posted or scheduled content', 'Your biggest breakthrough from these eight days'],
  },
];
---
<Base
  title="Your 8-Day Purposeful Content Shift™ | Kingdom Roe"
  description="Participant portal for The 8-Day Purposeful Content Shift™."
  noindex
>
  <section class="band portal-head">
    <div class="wrap narrow">
      <p class="eyebrow">Participant portal</p>
      <h1>Welcome to The 8-Day Purposeful Content Shift™</h1>
      <hr class="rule" />
      <p class="lede">Blessings, woman of God. In eight days, you will know who you are, who you are called to serve, and what to say to her, and you will leave with 20 or more pieces of content created.</p>
      <p>Each day unlocks after you finish the day before. Follow the steps, turn in your homework with your screenshots, then mark the day complete.</p>
      <p class="tip">All you need is your phone. Use the same phone or computer each day, because your progress is saved on this device.</p>
      <div class="schedule">
        <h2>Your Class Schedule</h2>
        <p class="tip">All classes are live on Zoom at {CHALLENGE.time}. On homework days, there is no class: complete that day’s steps in your portal.</p>
        <ul>{schedule.map(([d, w]) => <li class={w.startsWith('Homework') ? 'hw' : ''}><b>{d}</b><span>{w}</span></li>)}</ul>
      </div>
      <div class="formats">
        <Mockup kind="talking" />
        <Mockup kind="broll" />
        <Mockup kind="carousel" />
      </div>
      <div class="progress" aria-live="polite"><div class="bar"><i id="bar"></i></div><p id="progress-text">Day 1 of 8</p></div>
    </div>
  </section>

  <section class="band white">
    <div class="wrap narrow days">
      {days.map((d, i) => (
        <article class="day locked" data-day={i + 1} id={`day-${i + 1}`}>
          <header class="day-head">
            <span class="num">{i + 1}</span>
            <div>
              <p class="eyebrow">Day {i + 1}</p>
              <h2>{d.title}</h2>
            </div>
            <span class="status" aria-hidden="true"></span>
          </header>
          <p class="locked-note">Finish Day {i} to unlock this day.</p>
          <div class="day-body">
            <p class="why">{d.why}</p>
            <h3>Today’s steps</h3>
            <ol class="steps">{d.steps.map((s) => <li>{s}</li>)}</ol>
            {d.link && <p><a class="btn" href={d.link.href} target="_blank" rel="noopener">{d.link.label}</a></p>}
            {d.prompt && (
              <div class="prompt">
                <div class="prompt-head"><h3>{d.prompt.name}</h3><button class="copy" type="button">Copy prompt</button></div>
                <pre>{d.prompt.text}</pre>
                {d.prompt.note && <p class="note">{d.prompt.note}</p>}
              </div>
            )}
            {d.howto && d.howto.map((h) => (
              <div class="howto">
                <Mockup kind={h.kind} />
                <div>
                  <h3>{h.title}</h3>
                  <ol>{h.steps.map((s) => <li>{s}</li>)}</ol>
                </div>
              </div>
            ))}
            <div class="homework">
              <h3>Your homework</h3>
              <ul>{d.homework.map((h) => <li>{h}</li>)}</ul>
              {CHALLENGE.homeworkForm
                ? <a class="btn brown" href={CHALLENGE.homeworkForm} target="_blank" rel="noopener">Turn In Day {i + 1} Homework</a>
                : <span class="btn brown off" aria-disabled="true">Homework form coming soon</span>}
              <label class="confirm"><input type="checkbox" class="done-check" /> I turned in my Day {i + 1} homework and screenshots.</label>
              <button class="btn complete" type="button" disabled>{i === 7 ? 'Complete the Challenge' : `Complete Day ${i + 1} and Unlock Day ${i + 2}`}</button>
            </div>
          </div>
        </article>
      ))}

      <div class="finish" id="finish" hidden>
        <p class="eyebrow">You did it</p>
        <h2>You’ve Shifted From Encouragement to Attraction</h2>
        <p>You know who you are, who you are called to serve, and how to show up for her. If you’re ready to turn your content into an offer that attracts clients and creates income, I’d love to walk with you.</p>
        <div><a class="btn" href={APPLY_URL} target="_blank" rel="noopener">Apply to Work With Me</a></div>
      </div>
    </div>
  </section>
</Base>

<script is:inline>
  (function () {
    var KEY = 'kr-8day-done';
    var done = [];
    try { done = JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (e) { done = []; }
    if (!Array.isArray(done)) done = [];
    function save() { try { localStorage.setItem(KEY, JSON.stringify(done)); } catch (e) {} }
    var days = Array.prototype.slice.call(document.querySelectorAll('.day'));
    function render() {
      var unlocked = 1;
      while (done.indexOf(unlocked) !== -1 && unlocked < 9) unlocked++;
      days.forEach(function (el) {
        var n = +el.dataset.day;
        var isDone = done.indexOf(n) !== -1;
        el.classList.toggle('locked', n > unlocked);
        el.classList.toggle('done', isDone);
        el.querySelector('.status').textContent = isDone ? 'Complete' : (n > unlocked ? 'Locked' : 'Open');
        var btn = el.querySelector('.complete');
        var chk = el.querySelector('.done-check');
        if (isDone) { chk.checked = true; chk.disabled = true; btn.disabled = true; }
      });
      var count = Math.min(done.length, 8);
      document.getElementById('bar').style.width = (count / 8 * 100) + '%';
      document.getElementById('progress-text').textContent = count >= 8 ? 'All 8 days complete' : 'Day ' + Math.min(unlocked, 8) + ' of 8 · ' + count + ' complete';
      document.getElementById('finish').hidden = count < 8;
    }
    days.forEach(function (el) {
      var n = +el.dataset.day;
      var chk = el.querySelector('.done-check');
      var btn = el.querySelector('.complete');
      chk.addEventListener('change', function () { btn.disabled = !chk.checked; });
      btn.addEventListener('click', function () {
        if (!chk.checked || done.indexOf(n) !== -1) return;
        done.push(n); save(); render();
        var next = document.getElementById(n < 8 ? 'day-' + (n + 1) : 'finish');
        if (next) next.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
      var copy = el.querySelector('.copy');
      if (copy) copy.addEventListener('click', function () {
        var text = el.querySelector('pre').textContent;
        var ok = function () { copy.textContent = 'Copied'; setTimeout(function () { copy.textContent = 'Copy prompt'; }, 1800); };
        if (navigator.clipboard) navigator.clipboard.writeText(text).then(ok, function () {});
      });
    });
    render();
  })();
</script>

<style>
  .narrow { max-width: 780px; }
  .portal-head .narrow { display: grid; gap: 16px; }
  h1 { font-size: clamp(34px, 4.6vw, 50px); }
  .tip { font-size: 14px; color: var(--muted); }
  .schedule { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); padding: 22px; display: grid; gap: 10px; }
  .schedule h2 { font-size: clamp(22px, 3vw, 28px); }
  .schedule ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .schedule li { display: flex; justify-content: space-between; gap: 12px; padding: 8px 12px; border-radius: 8px; background: var(--pink-faint); font-size: 15px; }
  .schedule li span { color: var(--pink-deep); font-weight: 600; }
  .schedule li.hw { background: var(--canvas); }
  .schedule li.hw span { color: var(--muted); font-weight: 500; }
  .formats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; align-items: end; background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); padding: 20px 16px; }
  .progress { display: grid; gap: 8px; margin-top: 8px; }
  .bar { height: 8px; background: var(--pink-soft); border-radius: 999px; overflow: hidden; }
  .bar i { display: block; height: 100%; width: 0; background: var(--pink); transition: width .4s ease; }
  #progress-text { font-size: 14px; font-weight: 600; color: var(--pink-deep); }

  .days { display: grid; gap: 24px; }
  .day { border: 1px solid var(--line); border-radius: var(--radius); background: var(--canvas); padding: 28px; display: grid; gap: 18px; }
  .day.done { border-color: var(--pink-line); }
  .day-head { display: grid; grid-template-columns: auto 1fr auto; gap: 16px; align-items: center; }
  .day-head h2 { font-size: clamp(24px, 3vw, 30px); }
  .num { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; background: var(--pink); color: #fff; font-family: var(--display); font-size: 24px; font-weight: 700; }
  .status { font-size: 12px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--pink-deep); }
  .locked-note { display: none; color: var(--muted); font-size: 15px; }
  .day.locked { opacity: .6; }
  .day.locked .num { background: var(--muted); }
  .day.locked .day-body { display: none; }
  .day.locked .locked-note { display: block; }
  .day-body { display: grid; gap: 16px; }
  .why { font-family: var(--display); font-style: italic; font-size: 21px; line-height: 1.45; color: var(--pink-deep); }
  .day-body h3 { font-family: var(--sans); font-size: 15px; font-weight: 700; letter-spacing: .04em; color: var(--ink); }
  .steps, .homework ul, .howto ol { margin: 0; padding-left: 22px; display: grid; gap: 8px; }
  .prompt { background: var(--white); border: 1px solid var(--line); border-radius: 12px; padding: 18px; display: grid; gap: 12px; }
  .prompt-head { display: flex; flex-wrap: wrap; gap: 10px; justify-content: space-between; align-items: center; }
  .copy { appearance: none; border: 1px solid var(--pink); background: var(--pink-faint); color: var(--pink-deep); border-radius: 999px; padding: 10px 18px; min-height: 44px; font: 600 14px var(--sans); cursor: pointer; }
  pre { margin: 0; white-space: pre-wrap; word-break: break-word; font: 14px/1.6 var(--sans); color: var(--body); max-height: 320px; overflow: auto; }
  .note { font-size: 14px; color: var(--pink-deep); }
  .howto { background: var(--white); border: 1px solid var(--line); border-radius: 12px; padding: 20px; display: grid; grid-template-columns: 160px 1fr; gap: 20px; align-items: start; }
  .howto h3 { margin-bottom: 10px; }
  .homework { background: var(--white); border-top: 4px solid var(--pink); border-radius: 12px; padding: 20px; display: grid; gap: 14px; justify-items: start; }
  .confirm { display: flex; gap: 10px; align-items: flex-start; font-size: 15px; cursor: pointer; }
  .confirm input { width: 20px; height: 20px; margin-top: 3px; accent-color: var(--pink); flex: none; }
  .complete[disabled] { opacity: .4; cursor: not-allowed; }
  .finish { text-align: center; display: grid; gap: 16px; justify-items: center; padding: 48px 24px; border-top: 6px solid var(--pink); border-radius: var(--radius); background: var(--pink-faint); }
  .finish h2 { font-size: clamp(28px, 4vw, 40px); }
  @media (max-width: 600px) {
    .day { padding: 22px 18px; }
    .day-head { grid-template-columns: auto 1fr; }
    .status { grid-column: 2; }
    .homework .btn { white-space: normal; text-align: center; }
    .howto { grid-template-columns: 1fr; }
    .formats { gap: 8px; padding: 16px 8px; }
  }
</style>
