---
// Participants' portal for The 8-Day Purposeful Content Shift™.
// Private: not linked anywhere on the website, hidden from search. Send the link in the Flodesk welcome email.
// Each day unlocks after she turns in the day before. Progress is saved on her own phone or computer.
// Written for participants: warm steps only. Naomi's behind-the-scenes framework stays inside the prompts.
import Base from '../layouts/Base.astro';
import Mockup from '../components/Mockup.astro';
import { CHALLENGE, QUIZ_UNLOCKED_URL, APPLY_URL } from '../site';

const nichePrompt = `You are a Christian business coach who helps women of faith turn their gifts, expertise and life experience into a clear coaching niche.

Here is my information:
- What people already come to me for: [ANSWER]
- My experience, career or ministry background: [ANSWER]
- A pain or struggle I have personally overcome: [ANSWER]
- The kind of person I love serving most: [ANSWER]
- My Spiritual Daughter Archetype from the Which Daughter Are You? quiz: [Church Girl / Mystic Daughter / Called Daughter]

Step 1: Based on my answers, give me 3 possible niches. For each one, name the exact person I would serve (her age range, season of life and what she is struggling with).

Step 2: For each niche, write 2 purpose statements:
A) Desire version: "I help [who] achieve [desire] by [how I help them / what I give them]."
B) Pain point version: "I help [who] come out of [pain point] and step into [desire] by [how I help them / what I give them]."

Step 3: Tell me which niche fits my story and gifts best, and why.

Keep the language simple, warm and clear, the way I would say it out loud.`;

const questionsPrompt = `You are a content strategist for faith-based coaches.

My purpose statement: [PASTE YOUR PURPOSE STATEMENT]
The woman I serve: [DESCRIBE HER IN 2 OR 3 SENTENCES]

Give me 25 real questions the woman I serve is typing into Google, TikTok search and YouTube about her struggle. Write each question the way she would actually type it, in her own words.

Number them 1 to 25 so I can save them in my notes app.`;

const topicsPrompt = `You are a content strategist for faith-based coaches.

My purpose statement: [PASTE YOUR PURPOSE STATEMENT]
The woman I serve: [DESCRIBE HER IN 2 OR 3 SENTENCES]
My 25 questions: [PASTE YOUR 25 QUESTIONS]

For each of my 25 questions, give me 2 content topics I could talk about that answer her question and help her.

Write each topic as a short title, the way I would say it on camera. Number them so I can save them in my notes app.`;

const storyPrompt = `Write a short, heartfelt social media post in my voice, sharing my calling story. Keep it under 150 words.

My name: [YOUR NAME]
The problem I had: [YOUR PROBLEM]
The journey I went on, and how that problem was solved: [YOUR JOURNEY]
Who I want to help now: [WHO YOU WANT TO HELP]
Where I'm posting this: [TIKTOK, FACEBOOK OR INSTAGRAM]

Follow this order:
1. "Some time ago, I had…" (my problem)
2. The journey I went on, and how that problem was solved
3. Because of that, I want to help people get out of that same situation
4. I'm going to start talking about it right here
5. Ask for a little encouragement: "If you could like this post, it would mean so much, because I really feel led by God to do this."

Make it warm, humble and real. Write it the way I would talk to a friend.`;

const writePrompt = `You are a content writer for faith-based coaches. Help me write content from questions the woman I serve is asking.

My name and why she can trust me: [YOUR NAME, PLUS YEARS, ROLE OR A RESULT]
My purpose statement: [PASTE YOUR PURPOSE STATEMENT]
The woman I serve: [DESCRIBE HER IN 2 OR 3 SENTENCES]
My 10 questions and content topics: [PASTE 10 QUESTIONS AND THE TOPIC YOU CHOSE FOR EACH]

For each one, write a piece of content using this video formula:
1. Hook: one sentence for the first 3 seconds that grabs her attention.
2. Authority: one sentence with my name and why she can trust me.
3. Value: help her. Solve her problem, give her one tip in 2 or 3 simple steps, or share one surprising fact and what it means for her.
4. Call to action: one simple step, like "Follow me for more."

For each piece, give me:
- A script I can say to the camera in 30 to 60 seconds
- A caption that tells a short story and ends with the call to action

Number them 1 to 10. Write the way I would talk to a friend: simple, warm and clear.`;

type HowTo = { title: string; kind?: 'talking' | 'broll' | 'carousel'; steps: string[] };

const talking: HowTo = {
  title: 'How to make a talking head video', kind: 'talking',
  steps: [
    'Choose one of your scripts and read it out loud two or three times.',
    'Stand or sit facing a window so the light is on your face. Hold your phone at eye level, or lean it against something steady.',
    'Open TikTok or Instagram, tap the plus sign, and record yourself saying your script. Look at the camera like you are talking to one friend.',
    'Add your hook as text across the top of the screen, so she sees it even with the sound off.',
    'Check your text for typos. Add your caption, then post it.',
  ],
};
const broll: HowTo = {
  title: 'How to make a B-roll video', kind: 'broll',
  steps: [
    'Record 3 to 5 short clips of your everyday life, 3 to 5 seconds each: your coffee, your Bible, your desk, your hands writing, a walk outside.',
    'Open TikTok, tap the plus sign, then tap Upload and choose your clips.',
    'Tap Text and add the lines from your script, one at a time, so each line shows for a few seconds.',
    'Add soft music from TikTok’s sounds. Check your text for typos.',
    'Write a caption that tells a short story and ends with your call to action, then post it.',
  ],
};
const carousel: HowTo = {
  title: 'How to make a carousel post', kind: 'carousel',
  steps: [
    'Choose one of your scripts and break it into 5 to 7 short slides.',
    'Make your slides in the free Canva app, or with the photo and text tools in TikTok. Use the same colors and font on every slide.',
    'Make slide 1 bold and easy to read. That is the slide that stops her scroll. Make the last slide your call to action.',
    'Open TikTok, tap the plus sign, tap Upload, choose Photos, and select your slides in order.',
    'Write a caption that tells a short story and ends with your call to action, then post it.',
  ],
};
const studio: HowTo = {
  title: 'How to schedule in TikTok Studio',
  steps: [
    'Download the TikTok Studio app from the App Store or Google Play, and sign in with your TikTok account.',
    'Tap to upload a new post, and choose the video or photos you made.',
    'Add your caption.',
    'Choose to schedule it, then pick the day and time you want it to post.',
    'Repeat until your content is spread across the week, so you show up every day.',
  ],
};

type Prompt = { name: string; text: string; note?: string };
type Day = { title: string; date: string; kind: 'class' | 'fpa' | 'final'; why: string; steps: string[]; prompts?: Prompt[]; link?: { label: string; href: string; unlockAt?: string; unlockLabel?: string }; howto?: HowTo[]; styles?: boolean; homework: string[] };

const days: Day[] = [
  {
    title: 'It Starts With Identity',
    date: 'Wednesday, December 2', kind: 'class',
    why: 'Woman of God, you are exactly where you are supposed to be. You did not stumble in here. God has placed something in you, and over these eight days we are going to bring it out. It all starts with knowing who you are.',
    steps: [
      'Join tonight’s class at 5:00 PM Central.',
      'In class, we will take the Which Daughter Are You? mini quiz together. It unlocks below at 5:15 PM Central.',
      'After class, read your results slowly. Write down your Daughter, who you are called to serve, and the offer ideas that stood out to you. Pray over them.',
    ],
    link: { label: 'Take My Mini Quiz', href: QUIZ_UNLOCKED_URL, unlockAt: '2026-12-02T17:15:00-06:00', unlockLabel: 'Opens Wednesday, Dec 2 at 5:15 PM Central' },
    homework: ['A screenshot of your quiz results'],
  },
  {
    title: 'Who God Sent You To',
    date: 'Thursday, December 3', kind: 'class',
    why: 'You are not called to everybody. Tonight, you center your niche, and you discover the questions the woman God sent you to is already asking.',
    steps: [
      'Join tonight’s class at 5:00 PM Central.',
      'In class, use Prompt 1 to center your niche and write your purpose statement.',
      'After class, use Prompt 2 to find the 25 questions she is asking. Save them in your phone’s notes app.',
      'Save Prompt 3 for tomorrow. You will use it to turn your 25 questions into content topics.',
    ],
    prompts: [
      { name: 'Prompt 1: Find Your Niche and Your Purpose Statement', text: nichePrompt },
      { name: 'Prompt 2: The 25 Questions She Is Asking', text: questionsPrompt },
      { name: 'Prompt 3: Turn Your Questions Into Content Topics (for tomorrow)', text: topicsPrompt },
    ],
    homework: ['Your niche and your purpose statement: “I help…”', 'A screenshot of your 25 questions'],
  },
  {
    title: 'Step Out in Faith',
    date: 'Friday, December 4', kind: 'fpa',
    why: 'Today you take your first step in front of everyone. You tell your story, and you let the people around you know what God has placed on your heart.',
    steps: [
      'Write your calling story post. Use the prompt below, or fill in this short version: “Some time ago, I had [your problem]. I went on a journey, and that problem was solved. Because of that, I want to help people get out of that situation, so I’m going to start talking about it right here. I’d love a little encouragement. If you could like this post, it would mean so much, because I really feel led by God to do this.”',
      'Post it on TikTok, Facebook or Instagram.',
      'Screenshot your post and submit it below.',
      'Use Prompt 3 from yesterday to turn your 25 questions into content topics. Save them in your notes app, and bring them to tomorrow’s class.',
    ],
    prompts: [{ name: 'My Calling Story Post', text: storyPrompt }],
    homework: ['A screenshot of your calling story post', 'A screenshot of your content topics'],
  },
  {
    title: 'Say It With Purpose',
    date: 'Saturday, December 5', kind: 'class',
    why: 'Tonight you learn the video formula that turns your questions into content that draws her to you, and you write your first 10 pieces.',
    steps: [
      'Join tonight’s class at 5:00 PM Central. Bring your 25 questions and your content topics.',
      'Learn the video formula: Hook, Authority, Value, Call to Action.',
      'Choose 10 of your questions, and use Prompt 4 to write 10 pieces of content.',
      'Practice your videos in class.',
      'Tonight, post one video on TikTok, an Instagram video, or a 60-second Facebook reel. Then submit your link below.',
    ],
    prompts: [{ name: 'Prompt 4: Write My Content', text: writePrompt, note: 'Use this prompt again tomorrow for your next 10 pieces.' }],
    howto: [talking],
    homework: ['A screenshot of your 10 pieces of content', 'The link to the video you posted tonight'],
  },
  {
    title: 'Twenty Pieces Strong',
    date: 'Sunday, December 6', kind: 'fpa',
    why: 'Today you write 10 more pieces of content, so you have 20 ready. You also get to see the three kinds of videos you can make with them.',
    steps: [
      'Choose 10 more of your questions, and use Prompt 4 from yesterday to write 10 more pieces of content. That makes 20.',
      'Look at the three kinds of videos below: talking head videos, B-roll videos and carousel posts. Think about which of your 20 pieces fits each one.',
    ],
    styles: true,
    homework: ['A screenshot of your 20 pieces of content'],
  },
  {
    title: 'Show Up Without Saying a Word',
    date: 'Monday, December 7', kind: 'class',
    why: 'Not every post needs you talking. Tonight you learn B-roll videos and carousel posts, so you can show up with purpose even on the days you don’t feel camera ready.',
    steps: [
      'Before class, download the TikTok Studio app.',
      'Join tonight’s class at 5:00 PM Central. We will start with TikTok Studio, then B-roll and carousels.',
      'Learn to write captions that tell a short story and end with a call to action.',
      'Tonight, make B-roll videos and carousel posts from your 20 pieces, and post them. Post 3 times today.',
    ],
    howto: [studio, broll, carousel],
    homework: ['Screenshots or links of your 3 posts today'],
  },
  {
    title: 'Faith in Motion',
    date: 'Tuesday, December 8', kind: 'fpa',
    why: 'Faith moves. Today you make your talking head video, schedule your content, and keep showing up.',
    steps: [
      'Make a talking head video from one of your 20 pieces, and submit it below.',
      'Save or schedule at least 5 pieces of content in TikTok Studio. Screenshot them and submit them below.',
      'Post 3 times today.',
      'Keep scheduling. You need at least 10 posts scheduled by tomorrow’s final class.',
    ],
    howto: [talking, studio],
    homework: ['Your talking head video', 'A screenshot of at least 5 saved or scheduled posts', 'Screenshots or links of your 3 posts today'],
  },
  {
    title: 'You Shifted: Celebration Night',
    date: 'Wednesday, December 9', kind: 'final',
    why: 'You came in posting to encourage. You leave knowing who you are, who God sent you to, and what to say to her. Tonight, we celebrate what God has done, we thank Him, and we let Him lead us.',
    steps: [
      'Have at least 10 posts scheduled in TikTok Studio, and submit a screenshot below before class.',
      'Post 3 times today.',
      'Join our final class at 5:00 PM Central. Come ready to share your wins. We will celebrate, thank God, and pray together.',
    ],
    homework: ['A screenshot of your 10 scheduled posts', 'Screenshots or links of your 3 posts today'],
  },
];
---
<Base
  title="Your 8-Day Purposeful Content Shift™ | Kingdom Roe"
  description="Participant portal for The 8-Day Purposeful Content Shift™."
  noindex
>
  <section class="band portal-head">
    <div class="wrap narrow">
      <p class="eyebrow">Participant portal</p>
      <h1>Welcome to The 8-Day Purposeful Content Shift™</h1>
      <hr class="rule" />
      <p class="lede">Blessings, woman of God. In eight days, you will know who you are, who you are called to serve, and what to say to her, and you will leave with 20 or more pieces of content created.</p>
      <p>Each day unlocks after you finish the day before. Follow the steps, submit your faith-performing actions (FPA) with your screenshots, then mark the day complete.</p>
      <p class="tip">All you need is your phone. Use the same phone or computer each day, because your progress is saved on this device.</p>
      <div class="schedule">
        <h2>Your 8-Day Schedule</h2>
        <p class="tip">All classes are live on Zoom at {CHALLENGE.time}. On FPA Days (Faith-Performing Action Days), there is no class: take that day’s faith-performing actions in your portal.</p>
        <ol class="sched">{days.map((d, i) => (
          <li class={d.kind === 'fpa' ? 'hw' : ''}>
            <span class="sd">Day {i + 1} · {d.date.replace(/^(\w+), December/, (m, w) => w.slice(0, 3) + ', Dec')}</span>
            <b>{d.title}</b>
            <span class="sk">{d.kind === 'fpa' ? 'No class · FPA Day' : d.kind === 'final' ? 'Final class · 5 PM Central' : 'Class · 5 PM Central'}</span>
          </li>
        ))}</ol>
      </div>
      <div class="formats">
        <Mockup kind="talking" />
        <Mockup kind="broll" />
        <Mockup kind="carousel" />
      </div>
      <div class="progress" aria-live="polite"><div class="bar"><i id="bar"></i></div><p id="progress-text">Day 1 of 8</p></div>
    </div>
  </section>

  <section class="band white">
    <div class="wrap narrow days">
      {days.map((d, i) => (
        <article class="day locked" data-day={i + 1} id={`day-${i + 1}`}>
          <header class="day-head">
            <span class="num">{i + 1}</span>
            <div>
              <p class="eyebrow">Day {i + 1} · {d.date}</p>
              <h2>{d.title}</h2>
              <p class="kind">{d.kind === 'fpa' ? 'No class · Faith-Performing Action Day (FPA Day)' : d.kind === 'final' ? 'Final class at 5:00 PM Central' : 'Class at 5:00 PM Central'}</p>
            </div>
            <span class="status" aria-hidden="true"></span>
          </header>
          <p class="locked-note">Finish Day {i} to unlock this day.</p>
          <div class="day-body">
            <p class="why">{d.why}</p>
            <h3>Today’s steps</h3>
            <ol class="steps">{d.steps.map((s) => <li>{s}</li>)}</ol>
            {d.link && !d.link.unlockAt && <p><a class="btn" href={d.link.href} target="_blank" rel="noopener">{d.link.label}</a></p>}
            {d.link && d.link.unlockAt && (
              <div class="timed" data-unlock={d.link.unlockAt} data-href={d.link.href}>
                <span class="btn off timed-btn" aria-disabled="true">{d.link.label}</span>
                <p class="timed-note">Locked until class. {d.link.unlockLabel}. We take it together in class.</p>
              </div>
            )}
            {d.prompts && d.prompts.map((pr) => (
              <div class="prompt">
                <div class="prompt-head"><h3>{pr.name}</h3><button class="copy" type="button">Copy prompt</button></div>
                <pre>{pr.text}</pre>
                {pr.note && <p class="note">{pr.note}</p>}
              </div>
            ))}
            {d.styles && (
              <div class="styles">
                <div class="formats">
                  <Mockup kind="talking" />
                  <Mockup kind="broll" />
                  <Mockup kind="carousel" />
                </div>
                <ul>
                  <li><b>Talking head video:</b> you speaking to the camera. The fastest way for her to see you, hear you and trust you.</li>
                  <li><b>B-roll video:</b> short clips of your everyday life with your words on the screen.</li>
                  <li><b>Carousel post:</b> 5 to 7 photo slides she swipes through.</li>
                </ul>
              </div>
            )}
            {d.howto && d.howto.map((h) => (
              <div class={h.kind ? 'howto' : 'howto plain'}>
                {h.kind && <Mockup kind={h.kind} />}
                <div>
                  <h3>{h.title}</h3>
                  <ol>{h.steps.map((s) => <li>{s}</li>)}</ol>
                </div>
              </div>
            ))}
            <div class="homework">
              <h3>Your faith-performing actions (FPA) to submit</h3>
              <ul>{d.homework.map((h) => <li>{h}</li>)}</ul>
              {CHALLENGE.homeworkForm
                ? <a class="btn brown" href={CHALLENGE.homeworkForm} target="_blank" rel="noopener">Submit My Day {i + 1} FPA</a>
                : <span class="btn brown off" aria-disabled="true">Submission form coming soon</span>}
              <label class="confirm"><input type="checkbox" class="done-check" /> I submitted my Day {i + 1} FPA and screenshots.</label>
              <button class="btn complete" type="button" disabled>{i === 7 ? 'Complete the Challenge' : `Complete Day ${i + 1} and Unlock Day ${i + 2}`}</button>
            </div>
          </div>
        </article>
      ))}

      <div class="finish" id="finish" hidden>
        <p class="eyebrow">You did it</p>
        <h2>You’ve Shifted From Encouragement to Attraction</h2>
        <p>You know who you are, who you are called to serve, and how to show up for her. If you’re ready to turn your content into an offer that attracts clients and creates income, I’d love to walk with you.</p>
        <div><a class="btn" href={APPLY_URL} target="_blank" rel="noopener">Apply to Work With Me</a></div>
      </div>
    </div>
  </section>
</Base>

<script is:inline>
  (function () {
    var KEY = 'kr-8day-done';
    var done = [];
    try { done = JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (e) { done = []; }
    if (!Array.isArray(done)) done = [];
    function save() { try { localStorage.setItem(KEY, JSON.stringify(done)); } catch (e) {} }
    var days = Array.prototype.slice.call(document.querySelectorAll('.day'));
    function render() {
      var unlocked = 1;
      while (done.indexOf(unlocked) !== -1 && unlocked < 9) unlocked++;
      days.forEach(function (el) {
        var n = +el.dataset.day;
        var isDone = done.indexOf(n) !== -1;
        el.classList.toggle('locked', n > unlocked);
        el.classList.toggle('done', isDone);
        el.querySelector('.status').textContent = isDone ? 'Complete' : (n > unlocked ? 'Locked' : 'Open');
        var btn = el.querySelector('.complete');
        var chk = el.querySelector('.done-check');
        if (isDone) { chk.checked = true; chk.disabled = true; btn.disabled = true; }
      });
      var count = Math.min(done.length, 8);
      document.getElementById('bar').style.width = (count / 8 * 100) + '%';
      document.getElementById('progress-text').textContent = count >= 8 ? 'All 8 days complete' : 'Day ' + Math.min(unlocked, 8) + ' of 8 · ' + count + ' complete';
      document.getElementById('finish').hidden = count < 8;
    }
    days.forEach(function (el) {
      var n = +el.dataset.day;
      var chk = el.querySelector('.done-check');
      var btn = el.querySelector('.complete');
      chk.addEventListener('change', function () { btn.disabled = !chk.checked; });
      btn.addEventListener('click', function () {
        if (!chk.checked || done.indexOf(n) !== -1) return;
        done.push(n); save(); render();
        var next = document.getElementById(n < 8 ? 'day-' + (n + 1) : 'finish');
        if (next) next.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
      var copy = el.querySelector('.copy');
      if (copy) copy.addEventListener('click', function () {
        var text = el.querySelector('pre').textContent;
        var ok = function () { copy.textContent = 'Copied'; setTimeout(function () { copy.textContent = 'Copy prompt'; }, 1800); };
        if (navigator.clipboard) navigator.clipboard.writeText(text).then(ok, function () {});
      });
    });
    render();

    // Timed links (the Day 1 quiz): locked until the class time, then they open on their own.
    function checkTimed() {
      document.querySelectorAll('.timed').forEach(function (box) {
        if (box.dataset.open === '1') return;
        if (Date.now() >= Date.parse(box.dataset.unlock)) {
          box.dataset.open = '1';
          var href = box.dataset.href;
          var btn = box.querySelector('.timed-btn');
          var a = document.createElement('a');
          a.className = 'btn';
          a.href = href; a.target = '_blank'; a.rel = 'noopener';
          a.textContent = btn.textContent;
          btn.replaceWith(a);
          box.querySelector('.timed-note').textContent = 'Your quiz is open. Take it now with us in class.';
        }
      });
    }
    checkTimed();
    setInterval(checkTimed, 20000);
  })();
</script>

<style>
  .narrow { max-width: 780px; }
  .portal-head .narrow { display: grid; gap: 16px; }
  h1 { font-size: clamp(34px, 4.6vw, 50px); }
  .tip { font-size: 14px; color: var(--muted); }
  .schedule { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); padding: 22px; display: grid; gap: 10px; }
  .schedule h2 { font-size: clamp(22px, 3vw, 28px); }
  .sched { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .sched li { display: grid; gap: 2px; padding: 10px 14px; border-radius: 10px; background: var(--pink-faint); border-left: 4px solid var(--pink); }
  .sched li.hw { background: var(--canvas); border-left-color: var(--line); }
  .sched .sd { font-size: 12px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--pink-deep); }
  .sched b { font-family: var(--display); font-size: 20px; font-weight: 600; color: var(--ink); line-height: 1.25; }
  .sched .sk { font-size: 13px; color: var(--muted); }
  .kind { font-size: 13px; color: var(--muted); margin-top: 2px; }
  .formats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; align-items: end; background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); padding: 20px 16px; }
  .progress { display: grid; gap: 8px; margin-top: 8px; }
  .bar { height: 8px; background: var(--pink-soft); border-radius: 999px; overflow: hidden; }
  .bar i { display: block; height: 100%; width: 0; background: var(--pink); transition: width .4s ease; }
  #progress-text { font-size: 14px; font-weight: 600; color: var(--pink-deep); }

  .days { display: grid; gap: 24px; }
  .day { border: 1px solid var(--line); border-radius: var(--radius); background: var(--canvas); padding: 28px; display: grid; gap: 18px; }
  .day.done { border-color: var(--pink-line); }
  .day-head { display: grid; grid-template-columns: auto 1fr auto; gap: 16px; align-items: center; }
  .day-head h2 { font-size: clamp(24px, 3vw, 30px); }
  .num { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; background: var(--pink); color: #fff; font-family: var(--display); font-size: 24px; font-weight: 700; }
  .status { font-size: 12px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--pink-deep); }
  .locked-note { display: none; color: var(--muted); font-size: 15px; }
  .day.locked { opacity: .6; }
  .day.locked .num { background: var(--muted); }
  .day.locked .day-body { display: none; }
  .day.locked .locked-note { display: block; }
  .day-body { display: grid; gap: 16px; }
  .why { font-family: var(--display); font-style: italic; font-size: 21px; line-height: 1.45; color: var(--pink-deep); }
  .day-body h3 { font-family: var(--sans); font-size: 15px; font-weight: 700; letter-spacing: .04em; color: var(--ink); }
